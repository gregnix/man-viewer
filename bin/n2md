#!/usr/bin/env tclsh
# n2md -- convert nroff man pages to Markdown
#
# Uses the DocIR pipeline: nroff → AST → DocIR → Markdown.
#
# Usage:
#   n2md input.n                    # to stdout
#   n2md input.n output.md          # to file
#   n2md --batch dir/ outdir/       # convert all .n/.1/.3 files
#   cat input.n | n2md -            # from stdin
#   n2md --tip700 input.n           # TIP-700 format (YAML head, synopsis spans)

package require Tcl 8.6-

set scriptDir [file dirname [file normalize [info script]]]
set projectRoot [file dirname $scriptDir]
set libDir [file join $projectRoot lib tm]

# auto_path fuer pkgIndex-registrierte Module

# DocIR liegt in einem separaten Repository (siehe ../docir/). Gesucht wird
# es in DOCIR_HOME, als Nachbarordner und in ~/lib/tcltk/docir; erst danach
# gilt der normale Modulpfad (installiertes docir). Bis 2026-10-24 stand
# das nur im Kommentar, n2md fand docir nur, wenn es installiert war.
set docirCands {}
if {[info exists ::env(DOCIR_HOME)]} { lappend docirCands [file join $::env(DOCIR_HOME) lib tm] }
lappend docirCands [file join $projectRoot .. docir lib tm] \
    [file join ~ lib tcltk docir lib tm]
foreach c $docirCands {
    set c [file normalize $c]
    if {[file exists [file join $c docir-0.1.1.tm]]} { ::tcl::tm::path add $c; break }
}
# Eigene Module aus lib/tm/
::tcl::tm::path add [file join $projectRoot lib tm]
# Module laden
package require docir
package require docir::roffSource
package require docir::md
package require nroffparser
package require n2md::tip700 0.2

# Load modules
foreach mod {mvdebug-0.2.tm nroffparser-0.2.tm} {
    set modPath [file join $libDir $mod]
    if {[file exists $modPath]} {
        source $modPath
    } elseif {$mod eq "mvdebug-0.2.tm"} {
        # debug is optional -- create stubs if missing
        namespace eval debug {
            proc scope {args} {}
            proc log {args} {}
            proc level {args} { return 0 }
            proc getLevel {args} { return 0 }
            proc startTimer {args} {}
            proc stopTimer {args} {}
            proc traceLine {args} {}
            proc traceMacro {args} {}
            proc traceState {args} {}
            proc validateAST {args} { return {} }
        }
    } else {
        puts stderr "Error: $mod not found in $libDir"
        exit 1
    }
}

# (DocIR-Module wurden bereits oben direkt gesourced, package require
#  hier nicht mehr noetig und waere ggfs. ein Konflikt mit anderen
#  Repos die ein 'docir-md'-Paket im auto_path registriert haben.)

proc usage {} {
    puts "Usage: n2md \[input.n\] \[output.md\] \[options\]"
    puts ""
    puts "Options:"
    puts "  --batch DIR OUT     Convert all .n/.1/.3 files in DIR to OUT/"
    puts "  --tip700            TIP-700 format as written by man2markdown.tcl:"
    puts "                      YAML head, \"::: {.synopsis} :::\" with spans,"
    puts "                      SEE ALSO/KEYWORDS in the head, links to"
    puts "                      other pages (\[cd\], \[cd\]: cd.md)"
    puts "  --groups            with --batch --tip700: write into Tcl/, TclCAPI/,"
    puts "                      Tk/, TkCAPI/ like man2markdown (the links of"
    puts "                      the TIP-700 output assume this layout)"
    puts "  --help              Show this help"
    puts ""
    puts "Backwards-compatible (no-op) options for older scripts:"
    puts "  -lang LANG, --linkmode MODE"
    puts "    accepted but ignored. For controllable link modes see n2html."
    puts ""
    puts "Examples:"
    puts "  n2md dict.n                    # stdout"
    puts "  n2md dict.n dict.md            # to file"
    puts "  n2md --batch man/n/ docs/md/   # batch convert"
    puts "  cat dict.n | n2md -            # from stdin"
}

proc convertFile {inputFile outputFile {tip700 0}} {
    # Read input (Handbuchseiten sind ASCII oder UTF-8; ohne -encoding
    # haengt das Ergebnis von der Locale ab)
    if {$inputFile eq "-"} {
        fconfigure stdin -encoding utf-8
        set nroff [read stdin]
        set sourceFile ""
    } else {
        if {![file exists $inputFile]} {
            puts stderr "Error: File not found: $inputFile"
            return 0
        }
        set fh [open $inputFile r]
        fconfigure $fh -encoding utf-8
        set nroff [read $fh]
        close $fh
        set sourceFile $inputFile
    }

    # TIP 700: eigener Parser in n2md::tip700 (Links ueber die Seiten im
    # Ordner der Eingabedatei); sonst DocIR (nroff -> AST -> DocIR -> md)
    if {[catch {
        if {$tip700} {
            set md [n2md::tip700::convert $nroff -file $sourceFile]
        } else {
            set ast [nroffparser::parse $nroff $sourceFile]
            set ir  [docir::roff::fromAst $ast]
            set md [docir::md::render $ir]
            set md [n2md::tip700::uriLinks $md]
        }
    } err]} {
        puts stderr "Error converting $inputFile: $err"
        return 0
    }

    # Write output
    if {$outputFile eq ""} {
        fconfigure stdout -encoding utf-8
        puts -nonewline $md
    } else {
        file mkdir [file dirname $outputFile]
        set fh [open $outputFile w]
        fconfigure $fh -encoding utf-8
        puts -nonewline $fh $md
        close $fh
    }
    return 1
}

proc batchConvert {inputDir outputDir {tip700 0}} {
    set files [list]
    # .1 dazu (tclsh.1, wish.1); bis 2026-10-25 nur .n und .3
    foreach pattern {*.n *.1 *.3} {
        lappend files {*}[glob -nocomplain -directory $inputDir $pattern]
    }

    if {[llength $files] == 0} {
        puts stderr "No .n, .1 or .3 files found in $inputDir"
        return 0
    }

    file mkdir $outputDir
    set ok 0
    set fail 0

    foreach f [lsort $files] {
        set name [file rootname [file tail $f]]
        set outFile [file join $outputDir ${name}.md]
        if {$tip700 && $::groups} {
            # wie man2markdown: Unterordner Tcl, TclCAPI, Tk, TkCAPI; die
            # Links der TIP-700-Ausgabe (../TclCAPI/x.md) setzen das voraus,
            # und zipfs.n/zipfs.3 kommen sich nicht in die Quere
            set g Tcl
            catch {
                set fh [open $f r]
                fconfigure $fh -encoding utf-8
                set g [n2md::tip700::group [read $fh]]
                close $fh
            }
            set outFile [file join $outputDir $g ${name}.md]
        }
        if {[convertFile $f $outFile $tip700]} {
            incr ok
        } else {
            incr fail
        }
    }

    puts stderr "Converted: $ok  Failed: $fail  Total: [expr {$ok + $fail}]"
    return [expr {$fail == 0}]
}

# Parse arguments
set inputFile ""
set outputFile ""
set batch 0
set batchIn ""
set batchOut ""
set tip700 0
set groups 0

set i 0
while {$i < [llength $argv]} {
    set arg [lindex $argv $i]
    switch -- $arg {
        --help {
            usage
            exit 0
        }
        -lang {
            # Vorher fuer ast2md-Code-Block-Sprache. Heute kommt die
            # Sprache aus dem DocIR (vom roff-Mapper bestimmt). Wir
            # konsumieren das Argument fuer Backwards-Kompat aber
            # ignorieren es.
            incr i
        }
        --linkmode {
            # Vorher fuer ast2md-SEE-ALSO-Mapping. docir-md hat eigene
            # Logik (default: name.section.md). Argument konsumieren aber
            # ignorieren — fuer Online-/Anchor-Links siehe `n2html`.
            incr i
        }
        --tip700 {
            set tip700 1
        }
        --groups {
            set groups 1
        }
        --batch {
            set batch 1
            incr i
            set batchIn [lindex $argv $i]
            incr i
            set batchOut [lindex $argv $i]
        }
        default {
            if {$inputFile eq ""} {
                set inputFile $arg
            } elseif {$outputFile eq ""} {
                set outputFile $arg
            }
        }
    }
    incr i
}

# Bis 2026-10-21 rief --batch batchConvert mit $lang/$linkmode auf, die
# nie gesetzt wurden ("can't read lang"), und n2md endete immer mit 0.
if {$batch} {
    set ok [batchConvert $batchIn $batchOut $tip700]
} elseif {$inputFile ne ""} {
    set ok [convertFile $inputFile $outputFile $tip700]
} else {
    # Try stdin
    set ok [convertFile "-" "" $tip700]
}
exit [expr {$ok ? 0 : 1}]
